# Copy this file to .env.production on a VPS, or add the same keys in your
# hosting provider dashboard. Never commit real values.

NODE_ENV=production

# Admin login bootstrap. These are used only on the first run before
# .data/admin-auth-store.json is created.
# Admin login. Fixed in lib/admin-auth.ts as admin / admin1141; set these
# only to override that. Changing either one logs the admin out.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Native MySQL database for a FASTPANEL / VPS deployment.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rr888bd
DB_PASSWORD=your_secure_mysql_password
DB_NAME=rr888bd

# Compatibility aliases for older config files
DB_USERNAME=rr888bd
DB_DATABASE=rr888bd

# Optional game aggregator launch API.
AGGREGATOR_LAUNCH_URL=
AGGREGATOR_KEY=
NEXT_PUBLIC_AGGREGATOR=

# Public site URL, useful for production references.
NEXT_PUBLIC_APP_URL=https://rr888bd.site
NEXT_PUBLIC_SITE_URL=https://rr888bd.site
