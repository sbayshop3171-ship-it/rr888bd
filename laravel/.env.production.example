# Production environment for the FASTPANEL box.
# Copy to .env on the server, then fill DB_PASSWORD and run `php artisan key:generate`.

APP_NAME=rr888bd
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Created in FASTPANEL → Databases. The panel shows the name, user and host.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# `database` keeps sessions and the queue in MySQL, so nothing depends on a
# Redis instance this account does not control.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# The first admin account, created by `php artisan db:seed`.
# Change the password from the panel after the first sign-in, then clear these.
ADMIN_PHONE=
ADMIN_PASSWORD=
