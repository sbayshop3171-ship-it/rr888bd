# XAMPP / local MySQL configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rr888bd

# Compatibility aliases for older config files
DB_USERNAME=root
DB_DATABASE=rr888bd

# --- Game aggregator (optional) -----------------------------------------
# Set both and every game with a `code` in lib/catalogue.ts opens for real:
# /api/launch posts { gameCode, mode } here and frames the URL it answers with.
# Leave them unset and the site falls back to the handful of provider demo
# pages that need no operator account. See lib/launch.ts.
AGGREGATOR_LAUNCH_URL=
AGGREGATOR_KEY=
# Set to 1 at the same time. It is the browser's copy of "an aggregator exists",
# and only decides whether tapping a tile opens the player straight away or
# stops at the sheet first. No credential goes in it.
NEXT_PUBLIC_AGGREGATOR=

# --- Admin login ---------------------------------------------------------
# Used only when .data/admin-auth-store.json does not exist yet.
# After first live boot, change the password from /admin/settings.
# Admin login. Fixed in lib/admin-auth.ts as admin / admin1141; set these
# only to override that. Changing either one logs the admin out.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
